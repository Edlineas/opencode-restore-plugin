{
  "name": "opencode-restore-plugin",
  "version": "0.1.0",
  "description": "Restore messages and files for OpenCode AI - similar to Trae/Kiro's restore functionality",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:plugin": "ts-node test-plugin.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "restore",
    "undo",
    "snapshot",
    "file-recovery"
  ],
  "author": "weinuoer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edlineas/opencode-restore-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Edlineas/opencode-restore-plugin/issues"
  },
  "homepage": "https://github.com/Edlineas/opencode-restore-plugin#readme",
  "peerDependencies": {
    "@opencode-ai/sdk": ">=1.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
